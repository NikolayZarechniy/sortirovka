<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <xs:simpleType name="tZip">
        <xs:restriction base="xs:string">
            <xs:pattern value="\d{8}" />
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="tPhVal">
        <xs:restriction base="xs:string">
            <xs:pattern value="\+7-\d{3}-\d{2}-\d{2}-\d{3}" />
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="cOff">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="code" type="xs:ID" use="required" />
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <xs:complexType name="cPh">
        <xs:simpleContent>
            <xs:extension base="tPhVal">
                <xs:attribute name="type">
                    <xs:simpleType>
                        <xs:restriction base="xs:string">
                            <xs:enumeration value="work" />
                            <xs:enumeration value="home" />
                        </xs:restriction>
                    </xs:simpleType>
                </xs:attribute>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <xs:complexType name="cName">
        <xs:sequence>
            <xs:element name="first" type="xs:string" />
            <xs:element name="surname" type="xs:string" />
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="cAdr">
        <xs:all>
            <xs:element name="city" type="xs:string" />
            <xs:element name="street" type="xs:string" />
            <xs:element name="index" type="tZip" />
        </xs:all>
    </xs:complexType>

    <xs:complexType name="cPers">
        <xs:sequence>
            <xs:element name="name" type="cName" />
            <xs:element name="address" type="cAdr" />
            <xs:element name="phones">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="phone" type="cPh" minOccurs="0" maxOccurs="unbounded" />
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
        <xs:attribute name="id" type="xs:ID" use="required" />
        <xs:attribute name="office" type="xs:IDREF" use="required" />
    </xs:complexType>

    <xs:element name="notebook">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="offices">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="office" type="cOff" maxOccurs="unbounded" />
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="person" type="cPers" maxOccurs="unbounded" />
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>